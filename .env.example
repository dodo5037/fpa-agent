# ── FP&A Agent Dashboard — Environment Variables ──────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Z.ai / GLM API (used as fallback LLM provider if Ollama is unavailable)
GLM_API_KEY=your_glm_api_key_here

# Ollama (local LLM — primary provider for NL-to-SQL + memo generation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# DuckDB
DUCKDB_PATH=./data/fpa.duckdb

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000

# Anomaly Detection
ANOMALY_THRESHOLD_PCT=10.0
