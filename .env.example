# ── FP&A Agent Dashboard — Environment Variables ──────────────────────
# Copy to .env and fill in real values. .env is git-ignored.
# All settings have sensible defaults for local development.

# Ollama (local LLM for Ask AI and memo generation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# DuckDB (embedded database — file path)
DUCKDB_PATH=./data/fpa.duckdb

# FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend (Vite — API proxy target in development)
VITE_API_URL=http://localhost:8000

# Anomaly Detection (variance threshold percentage)
ANOMALY_THRESHOLD_PCT=10.0
